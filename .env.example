# --- Resolve ---
APP_ENV=dev
LOG_LEVEL=INFO
# Copy this file to .env and set a real password. .env is gitignored.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://resolve:change-me@localhost:5432/resolve
CHECKPOINT_DATABASE_URL=postgresql://resolve:change-me@localhost:5432/resolve
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=northwind_kb

# LLM: "off" is the default deterministic graph (no model calls). Do not set "on" until Phase 3.
RESOLVE_LLM=off
RETRIEVAL_BACKEND=memory
EMBEDDING_MODEL=hash-384
RERANKER=identity
QUERY_REWRITE=off

# Keys unused while RESOLVE_LLM=off
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Rate limit public demo
DEMO_SPEND_CAP_USD=5.00
RATE_LIMIT_PER_MINUTE=30

# GitHub (v2 BYO repo — unused in v1)
GITHUB_TOKEN=

API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
