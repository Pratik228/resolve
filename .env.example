# --- Resolve ---
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://resolve:resolve@localhost:5432/resolve
CHECKPOINT_DATABASE_URL=postgresql://resolve:resolve@localhost:5432/resolve
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=northwind_kb

# LLM: leave empty to run the deterministic demo path (no money from the model)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Rate limit public demo
DEMO_SPEND_CAP_USD=5.00
RATE_LIMIT_PER_MINUTE=30

# GitHub (v2 BYO repo — unused in v1)
GITHUB_TOKEN=

API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
